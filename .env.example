# ─── Anthropic Claude AI ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Airtable Database ────────────────────────────────────────────────────────
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# ─── Meta Cloud API WhatsApp ─────────────────────────────────────────────────
WHATSAPP_TOKEN=your_current_access_token
WHATSAPP_PHONE_NUMBER_ID=1152290557959699
WHATSAPP_VERIFY_TOKEN=any_random_secret_string_you_choose
# Required for automatic 60-day token refresh (exchange short-lived → long-lived)
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret

# ─── Railway API (auto-persist refreshed token across redeploys) ──────────────
# Create at: railway.app → Account Settings → Tokens
# The three RAILWAY_* IDs below are injected automatically inside Railway deployments.
RAILWAY_TOKEN=your_railway_api_token
# RAILWAY_PROJECT_ID     (auto-injected by Railway — do not set manually)
# RAILWAY_SERVICE_ID     (auto-injected by Railway — do not set manually)
# RAILWAY_ENVIRONMENT_ID (auto-injected by Railway — do not set manually)

# ─── Africa's Talking SMS ─────────────────────────────────────────────────────
AFRICASTALKING_API_KEY=your_at_api_key
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_SENDER_ID=JIBU

# ─── ClickPesa M-Pesa Payments ───────────────────────────────────────────────
CLICKPESA_CONSUMER_KEY=your_clickpesa_key
CLICKPESA_CONSUMER_SECRET=your_clickpesa_secret
MPESA_TILL_NUMBER=your_till_number

# ─── App Config ───────────────────────────────────────────────────────────────
PORT=3000
APP_URL=https://jibu-bot.railway.app
NODE_ENV=production
